{
  "name": "@local/vibe64-sessions",
  "version": "0.1.0",
  "description": "Owns plain Genesis-backed Vibe64 chat sessions.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "feature.vibe64-sessions"
      ],
      "requires": [
        "feature.vibe64-project",
        "feature.vibe64-terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64SessionsProvider.js",
            "export": "Vibe64SessionsProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers direct chat session, workspace preparation retry, conversation, diff, interrupt, and close routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Owns direct Genesis-backed chat sessions and delegates declared workspace preparation to Vibe64 terminals."
          }
        ],
        "containerTokens": {
          "server": [
            "feature.vibe64-sessions.service"
          ],
          "client": []
        }
      },
      "jskit": {
        "scaffoldShape": "feature-server-v1",
        "scaffoldMode": "orchestrator",
        "lane": "default"
      }
    },
    "mutations": {
      "dependencies": {
        "runtime": {
          "json-rest-schema": "^1.0.16"
        },
        "dev": {}
      },
      "packageJson": {
        "scripts": {}
      },
      "procfile": {},
      "files": [],
      "text": []
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.159",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "json-rest-schema": "^1.0.16"
  }
}
