{
  "name": "@local/vibe64-project",
  "version": "0.1.0",
  "description": "Owns project selection, trusted starters, Env values, and session runtime creation.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js",
    "./server/managedProject": "./src/server/managedProject.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "feature.vibe64-project"
      ],
      "requires": [
        "runtime.actions"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64ProjectProvider.js",
            "export": "Vibe64ProjectProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers project selection, trusted starter, and Env routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Provides project selection, trusted starters, Env state, and plain session runtimes."
          },
          {
            "subpath": "./server/managedProject",
            "summary": "Atomically prepares a blank Genesis working tree and its Vibe64-managed canonical Git repository."
          }
        ],
        "containerTokens": {
          "server": [
            "feature.vibe64-project.service"
          ],
          "client": []
        }
      },
      "jskit": {
        "scaffoldShape": "feature-server-v1",
        "scaffoldMode": "orchestrator",
        "lane": "default"
      }
    },
    "mutations": {
      "dependencies": {
        "runtime": {
          "json-rest-schema": "^1.0.16"
        },
        "dev": {}
      },
      "packageJson": {
        "scripts": {}
      },
      "procfile": {},
      "files": [],
      "text": []
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.159",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "json-rest-schema": "^1.0.16"
  }
}
