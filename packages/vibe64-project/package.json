{
  "name": "@local/vibe64-project",
  "version": "0.1.0",
  "description": "Owns project selection, trusted starters, Env values, and session runtime creation.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js",
    "./server/managedProject": "./src/server/managedProject.js",
    "./server/projectTemplates": "./src/server/projectTemplates.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.project"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.http"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64ProjectProvider.js",
            "export": "Vibe64ProjectProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/actions",
            "summary": "Exports the project operation action factory and action identifiers."
          },
          {
            "subpath": "./server/managedProject",
            "summary": "Builds a blank Genesis commit in temporary storage and installs it in Vibe64-managed canonical Git."
          },
          {
            "subpath": "./server/projectTemplates",
            "summary": "Materializes trusted project starters into explicit repository authorities."
          }
        ],
        "capabilities": [
          "vibe64.project"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.162",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "json-rest-schema": "^1.0.17"
  }
}
